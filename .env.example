# ==========================================
# Previsão Orçamentária — Variáveis de Ambiente
# ==========================================
# Copie este arquivo para .env e preencha as chaves.

# Chave da Anthropic (Claude) — PRINCIPAL
ANTHROPIC_API_KEY=sk-ant-api03-...

# Chave da OpenAI — FALLBACK (se Claude falhar)
OPENAI_API_KEY=sk-proj-...

# Provedor principal: anthropic (padrão)
PREVISAO_IA_PROVEDOR=anthropic

# Modelo Claude (padrão: claude-opus-4-8)
PREVISAO_IA_MODELO=claude-opus-4-8

# Modelo OpenAI para fallback (padrão: gpt-5.4)
PREVISAO_IA_MODELO_OPENAI=gpt-5.4

# Conexão MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=previsao
MYSQL_PASSWORD=previsao123
MYSQL_DATABASE=previsao
