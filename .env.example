# ==========================================
# Previsão Orçamentária — Variáveis de Ambiente
# ==========================================
# Copie este arquivo para .env e preencha as chaves.

# Chave da Anthropic (opcional; nao utilizada com provedor fixado em openai)
ANTHROPIC_API_KEY=

# Chave da OpenAI
OPENAI_API_KEY=sk-proj-...

# Provedor fixo: openai (sem fallback para Anthropic)
PREVISAO_IA_PROVEDOR=openai

# Modelo Claude (padrão: claude-sonnet-4-20250514)
PREVISAO_IA_MODELO=claude-sonnet-4-20250514

# Modelo OpenAI
PREVISAO_IA_MODELO_OPENAI=gpt-6.1-sol

# Nivel de raciocinio (modelos compativeis): low, medium, high, xhigh ou max
PREVISAO_IA_REASONING_EFFORT=high

# Conexão MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=previsao
MYSQL_PASSWORD=previsao123
MYSQL_DATABASE=previsao
